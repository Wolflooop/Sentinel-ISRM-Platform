// ============================================================================
// schema.prisma
// Plataforma de Gestión de Riesgos de Seguridad de la Información
//

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMERACIONES
// ============================================================================

enum Sector {
  PUBLICO
  PRIVADO
}

enum TamanoOrganizacion {
  MICRO
  PEQUENA
  MEDIANA
  GRANDE
}

enum EstadoOrganizacion {
  ACTIVA
  SUSPENDIDA
  INACTIVA
}

enum FormatoReporte {
  PDF
  XLSX
  CSV
}

enum AccionAuditoria {
  CREAR
  EDITAR
  ELIMINAR
  APROBAR
}

enum NivelRiesgo {
  BAJO
  MEDIO
  ALTO
  CRITICO
}

enum EstadoActivo {
  ACTIVO
  INACTIVO
  RETIRADO
}

enum OrigenAmenaza {
  INTERNO
  EXTERNO
}

enum EstadoRiesgo {
  IDENTIFICADO
  EN_ANALISIS
  EVALUADO
  TRATADO
  CERRADO
  MONITOREADO
  ACEPTADO
  // V2: un riesgo previamente CERRADO puede reabrirse (ver ResolucionRiesgo,
  // que es 1:N — un riesgo puede resolverse, reabrirse y volver a resolverse).
  REABIERTO
}

enum ResultadoEvaluacion {
  ACEPTABLE
  NO_ACEPTABLE
}

enum EstrategiaTratamiento {
  EVITAR
  MITIGAR
  TRANSFERIR
  ACEPTAR
}

// V2: valores renombrados respecto a V1.
// Migración de datos: PLANIFICADO -> PROPUESTO, EN_PROGRESO -> EN_EJECUCION,
// IMPLEMENTADO -> COMPLETADO. VENCIDO se mantiene sin cambios.
enum EstadoTratamiento {
  PROPUESTO
  EN_EJECUCION
  COMPLETADO
  VENCIDO
}

enum TipoControl {
  PREVENTIVO
  DETECTIVO
  CORRECTIVO
}

// V2: valores renombrados/consolidados respecto a V1.
// Migración de datos: NO_APLICADO -> NO_INICIADO, PLANIFICADO -> NO_INICIADO,
// EN_PROGRESO -> EN_PROGRESO (sin cambio), IMPLEMENTADO -> IMPLEMENTADO (sin
// cambio). Se agrega VERIFICADO como nuevo estado posterior a IMPLEMENTADO.
enum EstadoImplementacionControl {
  NO_INICIADO
  EN_PROGRESO
  IMPLEMENTADO
  VERIFICADO
}

// V2: origen de un Riesgo — reemplaza la obligatoriedad exclusiva de AAV.
enum OrigenRiesgo {
  AAV
  MANUAL
}

// V2: tipo de Evaluacion — antes implícito por posición (única evaluación
// por riesgo). Ahora explícito porque Evaluacion es una entidad con
// historial: un riesgo puede tener múltiples evaluaciones INHERENTE y
// RESIDUAL a lo largo del tiempo.
enum TipoEvaluacion {
  INHERENTE
  RESIDUAL
}

// V2: estado del ciclo de vida de una Evidencia adjunta a Riesgo/Tratamiento/Control.
enum EstadoEvidencia {
  SUBIDA
  VALIDADA
  RECHAZADA
}

enum TipoReporte {
  EJECUTIVO
  TECNICO
  GENERAL
}

// Fase 3 (Security Events): dominio separado de AccionAuditoria — estos son
// eventos de ciclo de vida de sesión/autenticación, no verbos CRUD sobre una
// entidad de negocio (ver EventoSeguridad más abajo).
enum TipoEventoSeguridad {
  AUTH_LOGIN_SUCCESS
  AUTH_LOGIN_FAILED
  AUTH_LOGOUT
  AUTH_SESSION_EXPIRED
  AUTH_ACCESS_DENIED
}

enum ResultadoEventoSeguridad {
  EXITO
  FALLIDO
}

enum SeveridadEventoSeguridad {
  INFO
  ADVERTENCIA
  ALTA
  CRITICA
}

// ============================================================================
// 1. ADMINISTRACIÓN
// ============================================================================

model Organizacion {
  id                            String             @id @default(uuid())
  nombre                        String             @unique
  sector                        Sector
  tamano                        TamanoOrganizacion
  paisIso                       String             @db.Char(2)
  correoContacto                String?
  telefono                      String?
  direccion                     String?
  estado                        EstadoOrganizacion @default(ACTIVA)
  diasAlertaTratamiento         Int?               @default(15)
  formatoReportePredeterminado  FormatoReporte?    @default(PDF)
  creadoEn                      DateTime           @default(now())

  usuarios    Usuario[]
  contextos   Contexto[]
  activos     Activo[]
  amenazas    Amenaza[]
  vulnerabilidades Vulnerabilidad[]
  controles   Control[]
  auditorias  Auditoria[]
  reportes    Reporte[]
  eventosSeguridad EventoSeguridad[]
}

model Usuario {
  id               String        @id @default(uuid())
  // Nullable a propósito (ver Fase 7 — jerarquía multiempresa): el
  // ADMINISTRADOR PRINCIPAL (Rol.tipo = SUPER_ADMIN) es un usuario global
  // que no pertenece a ninguna organización, por lo que organizacionId debe
  // ser NULL para ese caso. Para ADMIN_TIC y USUARIO_COMUN es obligatorio;
  // esa obligatoriedad se valida en la capa de aplicación (users.service),
  // ya que Prisma no expresa restricciones condicionales entre columnas de
  // tablas distintas (Usuario.organizacionId depende de Rol.tipo).
  organizacionId   String?
  organizacion     Organizacion? @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  rolId            String
  rol              Rol           @relation(fields: [rolId], references: [id], onDelete: Restrict)
  nombre           String
  // Auditoría: largo acotado a 320 (RFC 5321/5322 — 64 local-part + '@' +
  // 255 domain), en vez de TEXT sin límite explícito de dominio.
  email            String    @db.VarChar(320)
  passwordHash     String
  intentosFallidos Int       @default(0)
  bloqueadoHasta   DateTime?
  activo           Boolean   @default(true)
  ultimoLogin      DateTime?
  creadoEn         DateTime  @default(now())

  sesiones               Sesion[]
  auditorias             Auditoria[]
  activosResponsable     Activo[]      @relation("ActivoResponsable")
  evaluaciones           Evaluacion[]
  tratamientosResponsable Tratamiento[] @relation("TratamientoResponsable")
  tratamientosAprobados   Tratamiento[] @relation("TratamientoAprobadoPor")
  reportes               Reporte[]
  eventosSeguridad        EventoSeguridad[]
  riesgoHistorial         RiesgoHistorial[]
  controlHistorial        ControlHistorial[]
  riesgosCreados          Riesgo[]      @relation("RiesgoCreador")
  riesgosResponsable      Riesgo[]      @relation("RiesgoResponsable")
  controlesResponsable    Control[]     @relation("ControlResponsable")
  resolucionesRiesgo      ResolucionRiesgo[]
  comentarios             Comentario[]
  seguimientos            Seguimiento[]
  evidenciasSubidas       Evidencia[]   @relation("EvidenciaSubidaPor")
  evidenciasValidadas     Evidencia[]   @relation("EvidenciaValidadaPor")

  // Cambio (ver Fase 7): el login ya no pide organización (solo correo +
  // contraseña), así que el correo debe ser único de forma GLOBAL y no por
  // organización. Reemplaza la antigua @@unique([organizacionId, email]).
  @@unique([email])
  @@index([rolId])
  @@index([organizacionId])
  // Auditoría: consulta frecuente "usuarios activos de mi organización".
  @@index([organizacionId, activo])
}

// Nivel jerárquico del rol (ver Fase 7 — jerarquía de administración).
// Es un campo independiente de `nombre`: la lógica de negocio (quién puede
// crear a quién, quién puede elegir organización, etc.) se basa SIEMPRE en
// `tipo`, nunca en comparar el nombre del rol como texto libre.
enum TipoRol {
  SUPER_ADMIN   // Administrador Principal: global, organizacionId = null
  ADMIN_TIC     // Administrador TIC: siempre pertenece a una organización
  USUARIO_COMUN // Usuario común: siempre pertenece a una organización
}

model Rol {
  id          String  @id @default(uuid())
  nombre      String  @unique
  descripcion String?
  esSistema   Boolean @default(false)
  // Ver enum TipoRol. Determina la jerarquía real del rol.
  tipo        TipoRol @default(USUARIO_COMUN)

  usuarios Usuario[]
  permisos RolPermiso[]

  // Auditoría: el RBAC dinámico consulta/agrupa por tipo de rol en cada
  // verificación de autorización.
  @@index([tipo])
}

model Permiso {
  id          String  @id @default(uuid())
  recurso     String
  accion      String
  descripcion String?

  roles RolPermiso[]

  @@unique([recurso, accion])
}

// Entidad puente (N:M) — ver Fase 4, Puente 1
model RolPermiso {
  rolId     String
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Restrict)
  permisoId String
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Restrict)

  @@id([rolId, permisoId])
}

model Sesion {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiraEn  DateTime
  revocado  Boolean  @default(false)
  creadoEn  DateTime @default(now())

  @@index([usuarioId])
}

model Auditoria {
  id              String          @id @default(uuid())
  usuarioId       String
  usuario         Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  organizacionId  String
  organizacion    Organizacion    @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  entidad         String
  entidadId       String
  accion          AccionAuditoria
  // Excepción documentada a 1FN (ver Fase 6): estructura serializada, no un
  // valor atómico. Se mapea a JSONB de forma nativa en PostgreSQL.
  datosAnteriores Json?
  datosNuevos     Json?
  direccionIp     String
  fecha           DateTime        @default(now())

  // Tabla de solo inserción: no se exponen operaciones de update/delete desde
  // Prisma Client para este modelo a nivel de aplicación (ver Fase 5).
}

// ============================================================================
// 2. CONTEXTO ISO
// ============================================================================

model Contexto {
  id                   String   @id @default(uuid())
  organizacionId       String
  organizacion         Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  alcance              String   @db.Text
  criteriosAceptacion  String   @db.Text
  activo               Boolean  @default(false)
  creadoEn             DateTime @default(now())

  escalasImpacto       EscalaImpacto[]
  escalasProbabilidad  EscalaProbabilidad[]
  matricesRiesgo       MatrizRiesgo[]
  evaluaciones         Evaluacion[]

  @@index([organizacionId])
  // NOTA DE MIGRACIÓN MANUAL (ver Fase 3 y Fase 5):
  // Prisma no expresa nativamente un índice único parcial. Debe agregarse
  // manualmente en la migración generada:
  //   CREATE UNIQUE INDEX contexto_organizacion_activo_unique
  //     ON "Contexto" ("organizacionId") WHERE "activo" = true;
  // Esto garantiza, a nivel de base de datos, que exista como máximo un
  // Contexto con activo = true por organización.
}

model EscalaImpacto {
  id          String   @id @default(uuid())
  contextoId  String
  contexto    Contexto @relation(fields: [contextoId], references: [id], onDelete: Cascade)
  // Restricción de dominio (ver Fase 2/3): valores válidos entre 1 y 5.
  // Prisma no soporta restricciones CHECK de forma nativa; debe
  // implementarse mediante una migración SQL personalizada.
  nivel       Int
  etiqueta    String
  descripcion String?

  @@unique([contextoId, nivel])
}

model EscalaProbabilidad {
  id          String   @id @default(uuid())
  contextoId  String
  contexto    Contexto @relation(fields: [contextoId], references: [id], onDelete: Cascade)
  // Restricción de dominio (ver Fase 2/3): valores válidos entre 1 y 5.
  // Prisma no soporta restricciones CHECK de forma nativa; debe
  // implementarse mediante una migración SQL personalizada.
  nivel       Int
  etiqueta    String
  descripcion String?

  @@unique([contextoId, nivel])
}

model MatrizRiesgo {
  id                String      @id @default(uuid())
  contextoId        String
  contexto          Contexto    @relation(fields: [contextoId], references: [id], onDelete: Cascade)
  // Restricción de dominio (ver Fase 2/3): ambos valores válidos entre 1 y 5.
  // Prisma no soporta restricciones CHECK de forma nativa; deben
  // implementarse mediante una migración SQL personalizada.
  nivelProbabilidad Int
  nivelImpacto      Int
  nivelResultante   NivelRiesgo

  @@unique([contextoId, nivelProbabilidad, nivelImpacto])
}

// ============================================================================
// 3. INVENTARIO, AMENAZAS, VULNERABILIDADES
// ============================================================================

model CategoriaActivo {
  id          String  @id @default(uuid())
  nombre      String  @unique
  descripcion String?

  activos Activo[]
}

// Extremo "protegido" de la cadena AAV: lo que la organización necesita
// resguardar. Un mismo Activo puede aparecer en muchas filas de
// ActivoAmenazaVulnerabilidad (una por cada combinación amenaza+
// vulnerabilidad que le aplique).
model Activo {
  id                     String       @id @default(uuid())
  organizacionId         String
  organizacion           Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  categoriaId            String
  categoria              CategoriaActivo @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  nombre                 String
  descripcion            String?
  usuarioResponsableId   String
  usuarioResponsable     Usuario      @relation("ActivoResponsable", fields: [usuarioResponsableId], references: [id], onDelete: Restrict)
  ubicacion              String?
  // Restricción de dominio (ver Fase 2/3): valores válidos entre 1 y 5.
  // Prisma no soporta restricciones CHECK de forma nativa; debe
  // implementarse mediante una migración SQL personalizada.
  criticidad             Int
  valorEconomicoEstimado Decimal?     @db.Decimal(14, 2)
  estado                 EstadoActivo @default(ACTIVO)

  aavs ActivoAmenazaVulnerabilidad[]

  @@unique([organizacionId, nombre])
  @@index([categoriaId])
  @@index([criticidad])
}

model CategoriaAmenaza {
  id          String  @id @default(uuid())
  nombre      String  @unique
  descripcion String?

  amenazas Amenaza[]
}

// Segundo eslabón de la cadena AAV: la fuente potencial de daño. Una
// Amenaza no está ligada a un único Activo — el mismo registro de
// "phishing" o "falla eléctrica", por ejemplo, puede combinarse con
// muchos activos distintos (y con distintas vulnerabilidades) a través de
// ActivoAmenazaVulnerabilidad.
model Amenaza {
  id             String        @id @default(uuid())
  // Nullable: NULO = catálogo global administrado por el administrador del
  // sistema (ver Fase 3).
  organizacionId String?
  organizacion   Organizacion? @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  categoriaId    String
  categoria      CategoriaAmenaza @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  nombre         String
  descripcion    String?
  origen         OrigenAmenaza
  esPredefinida  Boolean       @default(false)

  aavs ActivoAmenazaVulnerabilidad[]

  // IMPORTANTE: en PostgreSQL, dos valores NULL nunca se consideran iguales
  // a efectos de una restricción UNIQUE. Por lo tanto, esta restricción NO
  // impide dos amenazas globales (organizacionId = NULL) con el mismo
  // nombre — solo aplica la unicidad entre amenazas de una misma
  // organización. La validación de amenazas globales duplicadas es
  // responsabilidad de la lógica de negocio (capa de aplicación), no del
  // modelo físico (ver Fase 3).
  @@unique([organizacionId, nombre])
  @@index([esPredefinida])
}

model CategoriaVulnerabilidad {
  id          String  @id @default(uuid())
  nombre      String  @unique
  descripcion String?

  vulnerabilidades Vulnerabilidad[]
}

// Tercer eslabón de la cadena AAV: la debilidad concreta que una Amenaza
// podría explotar. Igual que Amenaza, una Vulnerabilidad es reutilizable:
// la misma "contraseña débil" puede ser el punto de entrada para
// distintas amenazas sobre distintos activos — la combinación específica
// que sí importa para el análisis vive en ActivoAmenazaVulnerabilidad.
model Vulnerabilidad {
  id             String   @id @default(uuid())
  // V2: nullable — NULO = catálogo global administrado por el administrador
  // del sistema. Exactamente el mismo patrón que Amenaza.organizacionId.
  organizacionId String?
  organizacion   Organizacion? @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  categoriaId    String
  categoria      CategoriaVulnerabilidad @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  nombre         String
  descripcion    String?
  // Restricción de dominio (ver Fase 2/3): valores válidos entre 1 y 5.
  // Prisma no soporta restricciones CHECK de forma nativa; debe
  // implementarse mediante una migración SQL personalizada.
  severidad      Int
  referenciaCVE  String?
  esPredefinida  Boolean  @default(false)

  aavs ActivoAmenazaVulnerabilidad[]

  // IMPORTANTE (ver Amenaza): dos NULL nunca son iguales en PostgreSQL para
  // efectos de UNIQUE, por lo que esta restricción no impide duplicados
  // globales; la validación de duplicados globales queda en la capa de
  // aplicación, igual que para Amenaza.
  @@unique([organizacionId, nombre])
  @@index([severidad])
  @@index([esPredefinida])
}

// ============================================================================
// 4. ANÁLISIS (AAV, RIESGO, EVALUACIÓN)
// ============================================================================
//
// MODELO AAV (Activo–Amenaza–Vulnerabilidad) — guía rápida para quien no
// conozca el dominio:
//
//   Activo → Amenaza → Vulnerabilidad → Evaluación → Riesgo
//
// Un riesgo (en su origen AAV; ver enum OrigenRiesgo más abajo para el
// origen MANUAL) no es un dato que alguien "captura" directamente: es la
// CONSECUENCIA de que tres entidades independientes coincidan en un mismo
// punto:
//   - un Activo   (algo que la organización necesita proteger),
//   - una Amenaza (algo capaz de causarle daño),
//   - una Vulnerabilidad (una debilidad que esa amenaza podría explotar
//     en ese activo).
// Ese punto de encuentro es exactamente lo que representa el modelo puente
// ActivoAmenazaVulnerabilidad (ver Fase 4, Puente 2): no es una tabla de
// auditoría ni un catálogo, es la afirmación "esta amenaza podría explotar
// esta vulnerabilidad en este activo concreto". Por eso NO existe un
// endpoint CRUD independiente para AAV ni una pantalla propia en el
// frontend — se crea implícitamente al identificar un riesgo de origen AAV
// (ver risks.repository.ts / risks.service.ts), nunca de forma aislada.
//
// Cardinalidades a tener en cuenta:
//   - Un Activo puede estar expuesto a muchas Amenazas (y viceversa: una
//     Amenaza puede afectar a muchos Activos de la organización).
//   - Una Vulnerabilidad puede ser explotada por distintas Amenazas.
//   - Por eso la relación es ternaria (3 FKs) y no dos relaciones binarias:
//     la combinación específica activo+amenaza+vulnerabilidad es la unidad
//     mínima de análisis, no cada entidad por separado.
//
// La sola existencia de una fila AAV NO es todavía un riesgo cuantificado:
// para saber qué tan grave es, hace falta una Evaluacion, que es quien
// calcula probabilidad × impacto = nivel de riesgo (ver modelo Evaluacion).
// Un mismo Riesgo puede tener varias Evaluaciones a lo largo del tiempo
// (TipoEvaluacion.INHERENTE = antes de aplicar controles, RESIDUAL =
// después). Riesgo.evaluacionActualId siempre apunta a la vigente.
//
// Una vez que una evaluación resulta NO_ACEPTABLE, el flujo continúa hacia
// un Tratamiento (la decisión de qué hacer con el riesgo: mitigar,
// transferir, aceptar o evitar — ver EstrategiaTratamiento) que a su vez
// se apoya en uno o varios Control (las salvaguardas concretas que se
// implementan para reducir probabilidad o impacto — ver modelo Control y
// el puente TratamientoControl). El ciclo completo, entonces, es:
//   AAV → Riesgo → Evaluación (inherente) → Tratamiento → Control(es)
//         → Evaluación (residual, para medir si el tratamiento funcionó)
// ============================================================================

// Resuelve la asociación ternaria Activo + Amenaza + Vulnerabilidad
// (ver Fase 4, Puente 2).
//
// AAV representa la combinación técnica entre un activo, una amenaza y una
// vulnerabilidad. No es un módulo visible para usuarios finales, sino una
// entidad interna utilizada para construir escenarios de riesgo dentro del
// modelo ISO/IEC 27005: cada fila es un escenario concreto ("esta amenaza
// podría explotar esta vulnerabilidad en este activo"), no un catálogo
// independiente. Por eso no tiene endpoint CRUD, pantalla propia ni
// gestión manual desde el frontend — se crea junto con el Riesgo que la
// referencia (ver Riesgo.origen = AAV y risks.repository.ts), y su único
// propósito es servir de base para que una Evaluacion pueda calcular
// probabilidad × impacto sobre un escenario bien definido.
model ActivoAmenazaVulnerabilidad {
  id                String         @id @default(uuid())
  activoId          String
  activo            Activo         @relation(fields: [activoId], references: [id], onDelete: Restrict)
  amenazaId         String
  amenaza           Amenaza        @relation(fields: [amenazaId], references: [id], onDelete: Restrict)
  vulnerabilidadId  String
  vulnerabilidad    Vulnerabilidad @relation(fields: [vulnerabilidadId], references: [id], onDelete: Restrict)

  riesgo Riesgo?

  @@unique([activoId, amenazaId, vulnerabilidadId])
  @@index([amenazaId])
  @@index([vulnerabilidadId])
}

// V2: catálogo de categorías para riesgos de origen MANUAL (sin AAV).
model CategoriaIdentificacionRiesgo {
  id          String   @id @default(uuid())
  nombre      String   @unique
  descripcion String?

  riesgos Riesgo[]
}

// El riesgo en sí: el objeto de negocio que agrupa un escenario AAV (o un
// hallazgo MANUAL) con su historial de evaluaciones y tratamientos. Un
// Riesgo de origen AAV no tiene sentido sin su ActivoAmenazaVulnerabilidad
// asociado (por eso aavId es la FK que lo ancla), y no tiene un nivel de
// riesgo propio: ese cálculo vive siempre en la Evaluacion vigente
// (evaluacionActualId) — Riesgo es el contenedor del ciclo de vida, no
// quien calcula probabilidad/impacto.
model Riesgo {
  id                    String       @id @default(uuid())

  // V2: un Riesgo ahora tiene dos orígenes posibles. aavId deja de ser
  // obligatorio; la obligatoriedad condicional se expresa mediante el CHECK
  // "riesgo_origen_check" (ver migración SQL personalizada), que garantiza:
  //   - origen = AAV     -> aavId NOT NULL, titulo IS NULL
  //   - origen = MANUAL  -> aavId IS NULL, titulo NOT NULL,
  //                          categoriaIdentificacionId NOT NULL
  // Prisma no expresa CHECK condicionales entre columnas de forma nativa.
  origen                OrigenRiesgo
  aavId                 String?      @unique
  aav                   ActivoAmenazaVulnerabilidad? @relation(fields: [aavId], references: [id], onDelete: Restrict)

  // Campos exclusivos de origen MANUAL (NULL cuando origen = AAV).
  titulo                     String?
  descripcion                String?  @db.Text
  justificacionOrigen        String?  @db.Text
  categoriaIdentificacionId  String?
  categoriaIdentificacion    CategoriaIdentificacionRiesgo? @relation(fields: [categoriaIdentificacionId], references: [id], onDelete: Restrict)

  // V2: probabilidad/impacto/valorRiesgo/nivelRiesgoInherente/
  // nivelRiesgoResidual/fechaUltimoCalculo se retiran de Riesgo: ahora viven
  // exclusivamente en Evaluacion (ver modelo Evaluacion). Riesgo mantiene
  // únicamente un puntero a la evaluación vigente.
  evaluacionActualId    String?      @unique
  evaluacionActual      Evaluacion?  @relation("EvaluacionActual", fields: [evaluacionActualId], references: [id], onDelete: SetNull)

  estado                EstadoRiesgo @default(IDENTIFICADO)
  creadoEn              DateTime     @default(now())

  // V2: creadorId nunca cambia (fijado en creación). responsableId puede
  // cambiar y se actualiza únicamente mediante el endpoint dedicado
  // POST /riesgos/:id/responsable (ver risks.service.ts), nunca mediante un
  // PATCH genérico del riesgo.
  creadorId             String
  creador               Usuario      @relation("RiesgoCreador", fields: [creadorId], references: [id], onDelete: Restrict)
  // Auditoría: opcional. El flujo real es Crear -> Identificar -> Analizar
  // -> Asignar responsable -> Tratar; un riesgo recién creado no
  // necesariamente tiene responsable todavía.
  responsableId         String?
  responsable           Usuario?     @relation("RiesgoResponsable", fields: [responsableId], references: [id], onDelete: Restrict)

  evaluaciones  Evaluacion[] @relation("EvaluacionesDelRiesgo")
  historial     RiesgoHistorial[]
  tratamientos  Tratamiento[]
  resoluciones  ResolucionRiesgo[]
  comentarios   Comentario[]
  seguimientos  Seguimiento[]
  evidencias    Evidencia[]

  // Decisión Fase 8.1: sin organizacionId directo. El aislamiento
  // multi-tenant se resuelve vía JOIN: Riesgo -> AAV -> Activo -> Organizacion
  // (origen AAV) o Riesgo -> creador -> Organizacion (origen MANUAL).
  @@index([estado])
  @@index([origen])
  @@index([creadorId])
  @@index([responsableId])
  // Auditoría: soporta ordenamiento/filtrado por fecha de creación en
  // listados, reportes y dashboards.
  @@index([creadoEn])
}

// Trazabilidad de cambios de estado del riesgo (ver Fase 9 — UX/historial).
// Se escribe SIEMPRE dentro de la misma transacción que cambia Riesgo.estado
// (creación del riesgo, creación de evaluación, creación/actualización de
// tratamiento, resolución/reapertura), nunca desde un endpoint propio de
// "cambiar estado libre" — ese endpoint no existe y esta tabla no lo introduce.
model RiesgoHistorial {
  id             String       @id @default(uuid())
  riesgoId       String
  riesgo         Riesgo       @relation(fields: [riesgoId], references: [id], onDelete: Cascade)
  usuarioId      String
  usuario        Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  // NULL únicamente en la primera entrada (creación del riesgo): no hay
  // estado "anterior" a IDENTIFICADO.
  estadoAnterior EstadoRiesgo?
  estadoNuevo    EstadoRiesgo
  // NULL solo en la entrada de creación. Para cualquier transición de
  // estado posterior, la capa de aplicación exige un comentario no vacío
  // (ver evaluations.service.ts / treatments.service.ts).
  comentario     String?      @db.Text
  createdAt      DateTime     @default(now())

  @@index([riesgoId, createdAt])
}

// Quien efectivamente calcula el riesgo: probabilidad × impacto = nivel de
// riesgo (BAJO/MEDIO/ALTO/CRÍTICO), evaluado contra la matriz vigente del
// Contexto ISO de la organización. Un Riesgo puede acumular varias filas
// aquí a lo largo de su vida: una evaluación INHERENTE inicial (antes de
// aplicar controles) y, tras implementar un Tratamiento, una o más
// evaluaciones RESIDUAL (para medir si el tratamiento realmente redujo el
// riesgo). Riesgo.evaluacionActualId siempre apunta a la última vigente.
model Evaluacion {
  id              String              @id @default(uuid())
  riesgoId        String
  riesgo          Riesgo              @relation("EvaluacionesDelRiesgo", fields: [riesgoId], references: [id], onDelete: Restrict)
  contextoId      String
  contexto        Contexto            @relation(fields: [contextoId], references: [id], onDelete: Restrict)

  // V2: tipoEvaluacion distingue evaluaciones INHERENTE de RESIDUAL —
  // reemplaza la distinción implícita que antes vivía en
  // Riesgo.nivelRiesgoInherente / Riesgo.nivelRiesgoResidual.
  tipoEvaluacion  TipoEvaluacion

  // V2: campos migrados desde Riesgo (antes: probabilidad/impacto/
  // valorRiesgo/nivelRiesgoInherente|Residual vivían en Riesgo). Ahora cada
  // Evaluacion es dueña de su propio cálculo. Restricciones de dominio
  // (probabilidad/impacto entre 1-5, valorCalculado entre 1-25) se
  // implementan mediante CHECK en la migración SQL personalizada, igual que
  // en V1.
  probabilidad    Int
  impacto         Int
  valorCalculado  Int
  nivelRiesgo     NivelRiesgo

  resultado       ResultadoEvaluacion
  justificacion   String              @db.Text
  usuarioId       String
  usuario         Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  fechaEvaluacion DateTime            @default(now())

  // V2: un Tratamiento ya no depende exclusivamente de una Evaluacion (ver
  // modelo Tratamiento); esta relación se conserva únicamente como
  // referencia histórica de qué evaluación originó cada tratamiento
  // (Tratamiento.evaluacionOrigenId), por lo que deja de ser 1:1 obligatoria.
  tratamientosOrigen Tratamiento[] @relation("TratamientoEvaluacionOrigen")
  riesgoComoActual   Riesgo?       @relation("EvaluacionActual")
  comentarios        Comentario[]

  // Decisión Fase 8.1: sin organizacionId directo (ver Riesgo).
  @@index([riesgoId, fechaEvaluacion])
  @@index([tipoEvaluacion])
  // Auditoría: soporta filtrar/agrupar evaluaciones por Contexto ISO.
  @@index([contextoId])
}

// V2: historial completo de resoluciones. Un riesgo puede resolverse,
// reabrirse y volver a resolverse — por lo tanto es 1:N, nunca 1:1.
// Cada fila representa un evento puntual (RESOLUCION o REAPERTURA); el
// estado vigente del riesgo (CERRADO/REABIERTO/etc.) sigue viviendo en
// Riesgo.estado y se sincroniza desde la capa de aplicación en la misma
// transacción en que se inserta la fila correspondiente.
enum TipoResolucionRiesgo {
  RESOLUCION
  REAPERTURA
}

model ResolucionRiesgo {
  id           String               @id @default(uuid())
  riesgoId     String
  riesgo       Riesgo               @relation(fields: [riesgoId], references: [id], onDelete: Cascade)
  tipo         TipoResolucionRiesgo
  justificacion String              @db.Text
  usuarioId    String
  usuario      Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  fecha        DateTime             @default(now())

  @@index([riesgoId, fecha])
}

// V2: comentario polimórfico — pertenece exactamente a uno de
// Riesgo | Evaluacion | Tratamiento | Control. La exclusividad ("exactamente
// un destino") se garantiza mediante CHECK en la migración SQL personalizada
// (Prisma no expresa CHECK entre columnas nativamente); a nivel de
// aplicación el DTO de creación exige exactamente un *Id no nulo.
model Comentario {
  id            String   @id @default(uuid())
  riesgoId      String?
  riesgo        Riesgo?      @relation(fields: [riesgoId], references: [id], onDelete: Cascade)
  evaluacionId  String?
  evaluacion    Evaluacion?  @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)
  tratamientoId String?
  tratamiento   Tratamiento? @relation(fields: [tratamientoId], references: [id], onDelete: Cascade)
  controlId     String?
  control       Control?     @relation(fields: [controlId], references: [id], onDelete: Cascade)

  usuarioId     String
  usuario       Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  contenido     String       @db.Text
  creadoEn      DateTime     @default(now())

  @@index([riesgoId])
  @@index([evaluacionId])
  @@index([tratamientoId])
  @@index([controlId])
}

// V2: seguimiento polimórfico — pertenece exactamente a uno de
// Riesgo | Tratamiento | Control (nótese: sin Evaluacion, a diferencia de
// Comentario). Misma estrategia de CHECK que Comentario.
model Seguimiento {
  id            String   @id @default(uuid())
  riesgoId      String?
  riesgo        Riesgo?      @relation(fields: [riesgoId], references: [id], onDelete: Cascade)
  tratamientoId String?
  tratamiento   Tratamiento? @relation(fields: [tratamientoId], references: [id], onDelete: Cascade)
  controlId     String?
  control       Control?     @relation(fields: [controlId], references: [id], onDelete: Cascade)

  usuarioId     String
  usuario       Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  descripcion   String       @db.Text
  fecha         DateTime     @default(now())

  @@index([riesgoId])
  @@index([tratamientoId])
  @@index([controlId])
}

// V2: evidencia polimórfica — pertenece exactamente a uno de
// Riesgo | Tratamiento | Control. Misma estrategia de CHECK que Comentario.
model Evidencia {
  id            String          @id @default(uuid())
  riesgoId      String?
  riesgo        Riesgo?      @relation(fields: [riesgoId], references: [id], onDelete: Cascade)
  tratamientoId String?
  tratamiento   Tratamiento? @relation(fields: [tratamientoId], references: [id], onDelete: Cascade)
  controlId     String?
  control       Control?     @relation(fields: [controlId], references: [id], onDelete: Cascade)

  nombreArchivo String
  rutaArchivo   String
  estado        EstadoEvidencia @default(SUBIDA)
  subidoPorId   String
  subidoPor     Usuario         @relation("EvidenciaSubidaPor", fields: [subidoPorId], references: [id], onDelete: Restrict)
  validadoPorId String?
  validadoPor   Usuario?        @relation("EvidenciaValidadaPor", fields: [validadoPorId], references: [id], onDelete: Restrict)
  comentarioValidacion String?  @db.Text
  creadoEn      DateTime        @default(now())

  @@index([riesgoId])
  @@index([tratamientoId])
  @@index([controlId])
  @@index([estado])
}

// ============================================================================
// 5. TRATAMIENTO
// ============================================================================

// La respuesta de la organización cuando una Evaluacion resulta
// NO_ACEPTABLE: qué estrategia se sigue (mitigar, transferir, aceptar o
// evitar — ver EstrategiaTratamiento) y quién es responsable de
// ejecutarla. Un Tratamiento no reduce el riesgo por sí mismo: lo hace a
// través de uno o varios Control concretos (ver puente
// TratamientoControl más abajo), y su efectividad real solo se confirma
// con una nueva Evaluacion RESIDUAL posterior.
model Tratamiento {
  id                    String                @id @default(uuid())

  // V2: Tratamiento ahora depende principalmente de Riesgo, no de
  // Evaluacion. Un riesgo puede tener múltiples tratamientos a lo largo del
  // tiempo (por eso ya no es @unique).
  riesgoId              String
  riesgo                Riesgo                @relation(fields: [riesgoId], references: [id], onDelete: Restrict)

  // V2: se conserva únicamente como referencia histórica de qué evaluación
  // motivó este tratamiento — ya no es la FK obligatoria ni @unique.
  evaluacionOrigenId    String?
  evaluacionOrigen      Evaluacion?           @relation("TratamientoEvaluacionOrigen", fields: [evaluacionOrigenId], references: [id], onDelete: SetNull)

  estrategia            EstrategiaTratamiento
  descripcionPlan       String                @db.Text
  usuarioResponsableId  String
  usuarioResponsable    Usuario               @relation("TratamientoResponsable", fields: [usuarioResponsableId], references: [id], onDelete: Restrict)

  // V2: nuevos campos de gobernanza del tratamiento.
  fechaInicio           DateTime?             @db.Date
  justificacion         String?               @db.Text
  aprobadoPorId         String?
  aprobadoPor           Usuario?              @relation("TratamientoAprobadoPor", fields: [aprobadoPorId], references: [id], onDelete: Restrict)
  fechaAprobacion       DateTime?

  fechaLimite           DateTime              @db.Date
  estado                EstadoTratamiento     @default(PROPUESTO)
  // Restricción de dominio (ver Fase 2/3): valores válidos entre 0 y 100.
  // Prisma no soporta restricciones CHECK de forma nativa; debe
  // implementarse mediante una migración SQL personalizada.
  porcentajeAvance      Int                   @default(0)

  // V2: la relación 1:1 vía controlPrincipalId se elimina — un tratamiento
  // puede vincularse a varios controles y un control puede sostener varios
  // tratamientos (ver modelo puente TratamientoControl).
  controles     TratamientoControl[]
  comentarios   Comentario[]
  seguimientos  Seguimiento[]
  evidencias    Evidencia[]

  // Decisión Fase 8.1: sin organizacionId directo (ver Riesgo).
  @@index([riesgoId])
  @@index([evaluacionOrigenId])
  @@index([estado])
  @@index([fechaLimite])
}

// V2: puente N:M entre Tratamiento y Control — reemplaza la antigua FK 1:1
// Tratamiento.controlPrincipalId. Backfill (ver migración de datos): por
// cada Tratamiento V1 con controlPrincipalId no nulo, se inserta una fila
// aquí con esPrincipal = true; el resto de asociaciones nuevas se crean con
// esPrincipal = false salvo que se indique explícitamente lo contrario.
model TratamientoControl {
  tratamientoId String
  tratamiento   Tratamiento @relation(fields: [tratamientoId], references: [id], onDelete: Cascade)
  controlId     String
  control       Control     @relation(fields: [controlId], references: [id], onDelete: Restrict)
  // Conserva la semántica de "control principal" que existía en V1 como FK
  // única; ahora es un flag sobre la fila del puente.
  esPrincipal   Boolean     @default(false)
  asociadoEn    DateTime    @default(now())

  @@id([tratamientoId, controlId])
  @@index([controlId])
}

// La salvaguarda concreta (técnica, física u organizativa — ver
// TipoControl) que reduce probabilidad o impacto. Es el último eslabón de
// la cadena AAV → Riesgo → Evaluación → Tratamiento → Control: un Control
// por sí solo no está "atado" a un riesgo específico (puede reutilizarse
// en varios Tratamiento distintos, ver TratamientoControl), sino que su
// estadoImplementacion (NO_INICIADO → EN_PROGRESO → IMPLEMENTADO →
// VERIFICADO) es lo que en la práctica determina si el tratamiento que lo
// usa está realmente mitigando algo o solo planificado en el papel.
model Control {
  id                          String                       @id @default(uuid())
  // Nullable: NULO = catálogo global de referencia (ISO/IEC 27001 Anexo A).
  organizacionId              String?
  organizacion                Organizacion?                @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  // Sin restricción UNIQUE (ver Fase 3): distintas organizaciones pueden
  // adaptar un mismo código ISO con nombre/descripción propios.
  codigoIso27001              String?
  nombre                      String
  tipo                        TipoControl
  estadoImplementacion        EstadoImplementacionControl  @default(NO_INICIADO)
  // Debe permanecer NULL mientras estadoImplementacion != IMPLEMENTADO
  // (regla de negocio validada en la capa de aplicación, ver Fase 5).
  fechaImplementacion         DateTime?                    @db.Date
  observaciones               String?
  descripcionImplementacion   String?

  // V2: responsable operativo del control (distinto del responsable del
  // riesgo o del activo).
  responsableId               String?
  responsable                 Usuario?                     @relation("ControlResponsable", fields: [responsableId], references: [id], onDelete: Restrict)

  // V2: la relación directa Tratamiento[] se reemplaza por el puente
  // TratamientoControl (ver modelo Tratamiento).
  tratamientos  TratamientoControl[]
  historial     ControlHistorial[]
  comentarios   Comentario[]
  seguimientos  Seguimiento[]
  evidencias    Evidencia[]

  @@index([codigoIso27001])
  @@index([estadoImplementacion])
  @@index([responsableId])
}

// Trazabilidad de cambios de estado de implementación del control (misma
// lógica que RiesgoHistorial). Se escribe siempre dentro de la misma
// transacción/operación que efectivamente cambia estadoImplementacion.
model ControlHistorial {
  id             String                       @id @default(uuid())
  controlId      String
  control        Control                      @relation(fields: [controlId], references: [id], onDelete: Cascade)
  usuarioId      String
  usuario        Usuario                      @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  // NULL únicamente en la primera entrada (creación del control).
  estadoAnterior EstadoImplementacionControl?
  estadoNuevo    EstadoImplementacionControl
  // NULL solo en la entrada de creación; obligatorio en la capa de
  // aplicación para cualquier transición posterior (ver controls.service.ts).
  comentario     String?                      @db.Text
  createdAt      DateTime                     @default(now())

  @@index([controlId, createdAt])
}

// ============================================================================
// 6. REPORTES
// ============================================================================

model Reporte {
  id             String       @id @default(uuid())
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  usuarioId      String
  usuario        Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  tipo           TipoReporte
  formato        FormatoReporte
  rutaArchivo    String
  fecha          DateTime     @default(now())

  @@index([organizacionId])
  @@index([fecha])
}

// ============================================================================
// 7. SEGURIDAD (EVENTOS DE AUTENTICACIÓN/SESIÓN)
// ============================================================================

// Trazabilidad de eventos de seguridad (login, logout, sesión expirada,
// acceso denegado) — deliberadamente separada de `Auditoria`.
//
// `Auditoria` es una tabla de auditoría CRUD sobre entidades de negocio
// (Activo, Amenaza, Control, etc.): usuarioId/organizacionId son NOT NULL con
// onDelete: Restrict porque un registro de auditoría siempre corresponde a
// una acción ya autenticada y exitosa sobre una entidad existente.
//
// `EventoSeguridad` registra eventos de ciclo de vida de sesión, incluyendo
// los que ocurren ANTES de que exista una identidad confiable (p. ej. un
// login fallido con organización o email inexistentes). Forzar estos casos
// dentro de `Auditoria` habría requerido relajar sus constraints (NOT NULL +
// Restrict), afectando a los 7 módulos que ya la usan tal como está. Por eso
// usuarioId/organizacionId aquí son nullable con onDelete: SetNull — el
// registro debe poder crearse sin una identidad resuelta y debe sobrevivir
// aunque el usuario/organización se elimine después (valor forense).
//
// Tabla de solo inserción, igual que Auditoria: no se exponen operaciones de
// update/delete desde Prisma Client para este modelo a nivel de aplicación.
model EventoSeguridad {
  id             String                   @id @default(uuid())
  usuarioId      String?
  usuario        Usuario?                 @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  organizacionId String?
  organizacion   Organizacion?            @relation(fields: [organizacionId], references: [id], onDelete: SetNull)
  evento         TipoEventoSeguridad
  resultado      ResultadoEventoSeguridad
  severidad      SeveridadEventoSeguridad
  direccionIp    String
  descripcion    String
  // Contexto técnico adicional (p. ej. ruta solicitada, motivo específico de
  // rechazo del token) que no debe saturar `descripcion` en texto libre.
  detalles       Json?
  fecha          DateTime                 @default(now())

  @@index([usuarioId])
  @@index([organizacionId])
  @@index([evento])
  @@index([fecha])
  @@index([severidad])
  // Auditoría: consulta real es "eventos de tipo X en un rango de fechas"
  // (p. ej. AUTH_LOGIN_FAILED en las últimas 24h) — el compuesto resuelve
  // esto en un solo índice en vez de combinar los dos simples existentes.
  @@index([evento, fecha])
}