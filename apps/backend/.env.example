NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://<USUARIO>:<CONTRASEÑA>@localhost:5432/sentinel_isrm?schema=public"

JWT_SECRET="<CAMBIAR_POR_UN_SECRETO_LARGO_Y_UNICO>"
JWT_EXPIRES_IN=1h

# CORS — origen permitido del frontend
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=500

# Logging
LOG_LEVEL=info

# Seed inicial (opcional)
SEED_ADMIN_PASSWORD="<CONTRASEÑA_DEL_ADMIN_SEMILLA>"
