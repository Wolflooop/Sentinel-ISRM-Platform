# ============================================================================
# Sentinel ISRM Platform — Backend — Variables de entorno de ejemplo
# Copiar como .env y completar con valores reales. Nunca versionar .env real.
# ============================================================================

NODE_ENV=development
PORT=4000

# Cadena de conexión PostgreSQL (usada por Prisma)
DATABASE_URL="postgresql://usuario:password@localhost:5432/sentinel_isrm?schema=public"

# JWT — pendiente de definición: tiempos de expiración exactos y estrategia de
# rotación no están definidos en la Constitución (ver Seccion 3.3, mecanismo de
# sesion). Se deja un valor de ejemplo, no una decision de negocio.
JWT_SECRET=changeme_pendiente_de_definicion
JWT_EXPIRES_IN=1h

# CORS — origen permitido del frontend
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Política de bloqueo por intentos fallidos — pendiente de definición de
# negocio (ver Constitución). Dejar SIN DEFINIR desactiva la funcionalidad de
# bloqueo (queda preparada pero inactiva). Descomentar y asignar valores
# únicamente cuando exista una decisión oficial.
# AUTH_MAX_INTENTOS_FALLIDOS=5
# AUTH_BLOQUEO_MINUTOS=15
